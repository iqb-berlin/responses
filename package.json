{
  "name": "@iqb/responses",
  "author": "IQB - Institut zur Qualitätsentwicklung im Bildungswesen",
  "license": "MIT",
  "version": "5.5.0",
  "description": "Automatic coding.",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "workspaces": ["tooling/babel"],
  "scripts": {
    "test": "jest",
    "test_coding": "jest test/coding",
    "test:coverage": "jest --coverage",
    "test:differential": "npm run test:differential:golden && npm run test:differential:self && npm run test:differential:generated",
    "test:differential:golden": "node scripts/verify-dotnet-parity.js",
    "test:differential:generated": "node scripts/differential/run-generative-parity.js",
    "test:differential:self": "node scripts/differential/self-test.js",
    "test:differential:stress": "node scripts/differential/run-generative-parity.js --multiplier 5",
    "test:package": "node scripts/verify-package.js",
    "test:toolchain": "node tooling/babel/verify.mjs",
    "test_coding2text": "cd test && ts-node test-code2text case1",
    "test_getBaseVarsList": "cd test && ts-node test-getBaseVarsList get-base-vars-case",
    "prepare_publish": "node scripts/build-package.js",
    "npm_publish": "cd dist && npm publish --access public",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqb-berlin/responses.git"
  },
  "bugs": {
    "url": "https://github.com/iqb-berlin/responses/issues"
  },
  "homepage": "https://github.com/iqb-berlin/responses#readme",
  "eslintConfig": {
    "overrides": [
      {
        "files": [
          "*.ts"
        ],
        "extends": "./scripts/eslint-typescript.cjs",
        "parserOptions": {
          "project": [
            "./tsconfig.eslint.json"
          ]
        }
      },
      {
        "files": [
          "*.js"
        ],
        "extends": "@iqb/eslint-config/javascript"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@iqb/eslint-config": "^2.2.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "ajv": "^8.14.0",
    "fast-check": "^4.9.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "typescript": "7.0.2",
    "typescript-compat": "npm:typescript@5.4.5"
  },
  "overrides": {
    "@iqb/eslint-config": {
      "@typescript-eslint/parser": "$@typescript-eslint/parser",
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    },
    "eslint-config-airbnb-typescript": {
      "@typescript-eslint/parser": "$@typescript-eslint/parser",
      "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin"
    }
  },
  "dependencies": {
    "@iqbspecs/coding-scheme": "^3.5.0",
    "@iqbspecs/response": "^2.0.0",
    "@iqbspecs/variable-info": "^2.1.0",
    "mathjs": "^15.1.0"
  }
}
