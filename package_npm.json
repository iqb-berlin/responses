{
  "name": "@iqb/responses",
  "version": "5.4.0",
  "author": "IQB - Institut zur Qualitätsentwicklung im Bildungswesen",
  "license": "CC0 1.0",
  "description": "Automatic coding.",
  "dependencies": {
    "@iqbspecs/coding-scheme": "^3.5.0",
    "@iqbspecs/response": "^2.0.0",
    "@iqbspecs/variable-info": "^2.1.0",
    "mathjs": "^15.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqb-berlin/responses.git"
  },
  "bugs": {
    "url": "https://github.com/iqb-berlin/responses/issues"
  },
  "homepage": "https://github.com/iqb-berlin/responses#readme",
  "main": "index.js",
  "types": "index.d.ts",
  "module": "./esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json",
    "./*.js": {
      "import": {
        "types": "./esm/*.d.ts",
        "default": "./esm/*.js"
      },
      "require": {
        "types": "./*.d.ts",
        "default": "./*.js"
      }
    },
    "./*": {
      "import": {
        "types": "./esm/*.d.ts",
        "default": "./esm/*.js"
      },
      "require": {
        "types": "./*.d.ts",
        "default": "./*.js"
      }
    },
    "./presentation": {
      "import": {
        "types": "./esm/presentation/index.d.ts",
        "default": "./esm/presentation/index.js"
      },
      "require": {
        "types": "./presentation/index.d.ts",
        "default": "./presentation/index.js"
      }
    }
  }
}
